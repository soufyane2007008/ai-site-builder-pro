# ═══════════════════════════════════════════════════════════════════════════
# ملف المتغيرات البيئية لمشروع Ntfly
# ═══════════════════════════════════════════════════════════════════════════
#
# ⚠️ تحذير مهم:
# هذه القيم يجب أن يُدخلها المطور يدوياً في بيئة آمنة.
# Lovable لا ينتج مفاتيح ولا يتصل بخدمات خارجية.
#
# 📋 التعليمات:
# 1. انسخ هذا الملف إلى .env
# 2. املأ القيم من Firebase Console
# 3. لا ترفع ملف .env إلى Git أبداً
#
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# إعدادات Firebase الأساسية
# ─────────────────────────────────────────────────────────────────────────────

# مفتاح API العام - يُستخدم لتعريف المشروع (ليس سرياً لكن لا تنشره)
VITE_FIREBASE_API_KEY=

# نطاق المصادقة - عادةً: [projectId].firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# معرف المشروع الفريد في Firebase
VITE_FIREBASE_PROJECT_ID=

# عنوان مخزن الملفات - عادةً: [projectId].appspot.com
VITE_FIREBASE_STORAGE_BUCKET=

# معرف مرسل الإشعارات (Cloud Messaging)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# معرف التطبيق الفريد
VITE_FIREBASE_APP_ID=

# معرف Google Analytics (اختياري)
VITE_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# مفاتيح الذكاء الاصطناعي (اختياري - يُدار عبر لوحة الأدمن)
# ─────────────────────────────────────────────────────────────────────────────
#
# ⛔ ملاحظة أمنية مهمة:
# يُفضل عدم وضع هذه المفاتيح هنا.
# الطريقة الآمنة: إدخالها مشفرة عبر لوحة الأدمن.
# هذه الحقول للتطوير المحلي فقط.
#

# مفتاح OpenAI API
VITE_AI_OPENAI_KEY=

# مفتاح Google Gemini API
VITE_AI_GEMINI_KEY=

# مفتاح Anthropic Claude API
VITE_AI_CLAUDE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# إعدادات التطبيق
# ─────────────────────────────────────────────────────────────────────────────

# وضع التطبيق: development | production
VITE_APP_MODE=development

# تفعيل وضع المحاكاة (بدون Firebase حقيقي)
VITE_MOCK_MODE=false

# الحد الأقصى للمشاريع لكل مستخدم في 24 ساعة
VITE_PROJECT_QUOTA_24H=1

# ═══════════════════════════════════════════════════════════════════════════
# نهاية الملف
# ═══════════════════════════════════════════════════════════════════════════
